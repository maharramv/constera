# Vercel Marketplace > Neon inteqrasiyası bu ünvanı avtomatik yarada bilər.
DATABASE_URL=

# İlk super administratorun təhlükəsiz yaradılması üçün ən azı 32 simvolluq gizli açar.
ADMIN_SETUP_TOKEN=

# Vercel Cron sorğularını qorumaq üçün gizli açar.
CRON_SECRET=

# Məhsul şəkilləri və sənədlər üçün Vercel Blob açarı.
BLOB_READ_WRITE_TOKEN=

# Bildirişlər üçün n8n/inteqrasiya webhook-ları. Boş olduqda bildiriş növbədə saxlanır.
EMAIL_WEBHOOK_URL=
WHATSAPP_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_SECRET=
ADMIN_NOTIFICATION_EMAIL=
ADMIN_NOTIFICATION_PHONE=

# Administrator 2FA sirlərini şifrələmək üçün ən azı 32 simvolluq ayrıca açar.
TWO_FACTOR_ENCRYPTION_KEY=

# PWA brauzer bildirişləri üçün VAPID açarları.
VAPID_SUBJECT=mailto:security@constera.az
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Müqaviləli provayderlər üçün yalnız HTTPS webhook-lar.
PAYMENT_WEBHOOK_URL=
PAYMENT_WEBHOOK_SECRET=

# Bank köçürməsi üçün müştəriyə göstərilən rəsmi rekvizitlər.
BANK_TRANSFER_ACCOUNT_NAME=
BANK_TRANSFER_BANK_NAME=
BANK_TRANSFER_IBAN=
BANK_TRANSFER_TAX_ID=

EINVOICE_WEBHOOK_URL=
EINVOICE_WEBHOOK_SECRET=
AI_ESTIMATE_WEBHOOK_URL=
AI_ESTIMATE_WEBHOOK_SECRET=

# Gzip edilmiş gündəlik əməliyyat backup-ını qəbul edən özəl HTTPS yaddaş endpoint-i.
BACKUP_WEBHOOK_URL=
BACKUP_WEBHOOK_SECRET=

# Webhook yoxdursa, backup üçün ayrıca özəl Vercel Blob store token-i.
# Məhsul mediasının BLOB_READ_WRITE_TOKEN açarını burada təkrar istifadə etməyin.
BACKUP_BLOB_READ_WRITE_TOKEN=

# Könüllü ayarlar
SESSION_COOKIE_NAME=constera_session
APP_ORIGIN=https://constera.az
