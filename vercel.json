{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci && npm run verify:deploy",
  "buildCommand": "npm run build:static",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.constera.az" }],
      "destination": "https://constera.az/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.constera.az" }],
      "destination": "https://constera.az/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/api/account", "destination": "/api/admin?__route=account" },
    { "source": "/api/ai", "destination": "/api/admin?__route=ai" },
    { "source": "/api/analytics", "destination": "/api/admin?__route=analytics" },
    { "source": "/api/audit", "destination": "/api/admin?__route=audit" },
    { "source": "/api/backup", "destination": "/api/admin?__route=backup" },
    { "source": "/api/cabinet", "destination": "/api/admin?__route=cabinet" },
    { "source": "/api/catalog-quality", "destination": "/api/admin?__route=catalog-quality" },
    { "source": "/api/catalog-staging", "destination": "/api/admin?__route=catalog-staging" },
    { "source": "/api/categories", "destination": "/api/admin?__route=categories" },
    { "source": "/api/contact", "destination": "/api/admin?__route=contact" },
    { "source": "/api/crm", "destination": "/api/admin?__route=crm" },
    { "source": "/api/entities", "destination": "/api/admin?__route=entities" },
    { "source": "/api/events", "destination": "/api/admin?__route=events" },
    { "source": "/api/fulfillments", "destination": "/api/admin?__route=fulfillments" },
    { "source": "/api/imports", "destination": "/api/admin?__route=imports" },
    { "source": "/api/integrations", "destination": "/api/admin?__route=integrations" },
    { "source": "/api/inventory", "destination": "/api/admin?__route=inventory" },
    { "source": "/api/launch-center", "destination": "/api/admin?__route=launch-center" },
    { "source": "/api/logistics", "destination": "/api/admin?__route=logistics" },
    { "source": "/api/media", "destination": "/api/admin?__route=media" },
    { "source": "/api/merchant-feed", "destination": "/api/admin?__route=merchant-feed" },
    { "source": "/api/notifications", "destination": "/api/admin?__route=notifications" },
    { "source": "/api/operations-center", "destination": "/api/admin?__route=operations-center" },
    { "source": "/api/orders", "destination": "/api/admin?__route=orders" },
    { "source": "/api/price-monitor", "destination": "/api/admin?__route=price-monitor" },
    { "source": "/api/cron-production-monitor", "destination": "/api/admin?__route=production-monitor" },
    { "source": "/api/procurement", "destination": "/api/admin?__route=procurement" },
    { "source": "/api/procurement-plans", "destination": "/api/admin?__route=procurement-plans" },
    { "source": "/api/project-site-control", "destination": "/api/admin?__route=project-site-control" },
    { "source": "/api/project-site-journal", "destination": "/api/admin?__route=project-site-journal" },
    { "source": "/api/projects", "destination": "/api/admin?__route=projects" },
    { "source": "/api/proposals", "destination": "/api/admin?__route=proposals" },
    { "source": "/api/product-offers", "destination": "/api/admin?__route=product-offers" },
    { "source": "/api/purchase-orders", "destination": "/api/admin?__route=purchase-orders" },
    { "source": "/api/rental-bookings", "destination": "/api/admin?__route=rental-bookings" },
    { "source": "/api/reviews", "destination": "/api/admin?__route=reviews" },
    { "source": "/api/scheduled-backup", "destination": "/api/admin?__route=scheduled-backup" },
    { "source": "/api/supplier-performance", "destination": "/api/admin?__route=supplier-performance" },
    { "source": "/api/supplier-feeds", "destination": "/api/admin?__route=supplier-feeds" },
    { "source": "/api/support", "destination": "/api/admin?__route=support" },
    { "source": "/api/tender-bids", "destination": "/api/admin?__route=tender-bids" },
    { "source": "/api/tenders", "destination": "/api/admin?__route=tenders" },
    { "source": "/api/users", "destination": "/api/admin?__route=users" }
  ],
  "functions": {
    "api/*.js": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/cron-price-freshness",
      "schedule": "15 2 * * *"
    },
    {
      "path": "/api/cron-notifications",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/scheduled-backup",
      "schedule": "15 3 * * *"
    },
    {
      "path": "/api/cron-production-monitor",
      "schedule": "17 4 * * *"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=31536000, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; connect-src 'self'; font-src 'self'; form-action 'self'; frame-ancestors 'self'; img-src 'self' data: blob: https:; manifest-src 'self'; object-src 'none'; script-src 'self'; style-src 'self'; worker-src 'self'" }
      ]
    }
  ]
}
