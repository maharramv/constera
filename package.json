{
  "name": "constera-enterprise-v2",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "ConstEra Korporativ v2 statik bazar platforması.",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "build": "npm run build:static",
    "build:static": "node scripts/vercel-build.mjs",
    "vercel-build": "npm run build:static",
    "audit": "node scripts/audit-site.mjs",
    "audit:dist": "node scripts/audit-build.mjs",
    "check:syntax": "node scripts/check-javascript.mjs",
    "test:api": "node --test tests/api/*.test.mjs",
    "test:site": "node --test tests/site/*.test.mjs",
    "test:layout": "playwright test",
    "db:migrate": "node scripts/migrate-database.mjs",
    "db:seed": "node scripts/seed-database.mjs",
    "db:import-scraper": "node scripts/import-scraper-catalog.mjs",
    "db:audit": "node scripts/audit-database.mjs",
    "db:smoke": "node scripts/smoke-commerce.mjs && node scripts/smoke-operations.mjs",
    "db:create-admin": "node scripts/create-admin.mjs",
    "check:production": "node scripts/check-production.mjs",
    "check": "npm run audit && npm run check:syntax && npm run test:api && npm run test:site && npm run build:static && npm run audit:dist",
    "check:full": "npm run check && npm run test:layout"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/blob": "^2.6.1",
    "fflate": "^0.8.3",
    "read-excel-file": "^9.3.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "esbuild": "0.28.1"
  }
}
